{
  "datasets": [
    {
      "name": "511b0905",
      "displayName": "Top Industries Ranked by Average Funding Raised",
      "queryLines": [
        "select industry, avg(funds_raised_millions) as avg_funds_raised, year(`date`), country\n",
        "from layoffs_staging4\n",
        "group by industry, year(`date`), country\n",
        "having industry is not null\n",
        "and country = 'United States'\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    },
    {
      "name": "703077ac",
      "displayName": "layoffs_staging4",
      "config": {
        "version": "1.1",
        "source": "world_layoffs.layoffs.layoffs_staging4",
        "dimensions": [
          {
            "expr": "source.*"
          }
        ],
        "measures": [
          {
            "name": "count",
            "expr": "COUNT(*)",
            "comment": "Represents the total number of rows in the dataset. Use this measure to count all",
            "displayName": "Count"
          }
        ]
      }
    },
    {
      "name": "266c903a",
      "displayName": "Distinct Layoff Years Extracted from Data",
      "queryLines": [
        "select distinct year(`date`)\n",
        "from layoffs_staging4\n",
        "where `date` is not null\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    },
    {
      "name": "c6c14d5d",
      "displayName": "Unique Layoff Locations Overview",
      "queryLines": [
        "select distinct location, country\r\n",
        "from layoffs_staging4\r\n",
        "group by country, location\r\n",
        "having country = 'United States'\r\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    },
    {
      "name": "1d096fff",
      "displayName": "Monthly Layoff Totals Grouped by Year and Month",
      "queryLines": [
        "select sum(total_laid_off), month(`date`), year(`date`)\r\n",
        "from layoffs_staging4\r\n",
        "group by month(`date`), year(`date`)\r\n",
        "having sum(total_laid_off) is not null\r\n",
        "and month(`date`) is not null\r\n",
        "and year(`date`) is not null\r\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    },
    {
      "name": "3a76b96d",
      "displayName": "United States Industry Layoffs Summary by Year",
      "queryLines": [
        "select industry, sum(total_laid_off) as total_laid_off, year(`date`), country\n",
        "from layoffs_staging4\n",
        "group by industry, year(`date`), country\n",
        "having industry is not null\n",
        "and total_laid_off is not null\n",
        "and year(`date`) is not null\n",
        "and country = 'United States'\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    },
    {
      "name": "3f99c2b8",
      "displayName": "United States Industry Layoff Rates by Year",
      "queryLines": [
        "select industry, avg(percentage_laid_off) as avg_percentage_laid_off, country, year(`date`)\n",
        "from layoffs_staging4\n",
        "group by industry, country, year(`date`)\n",
        "having industry is not null\n",
        "and avg_percentage_laid_off is not null\n",
        "and country = 'United States'\n",
        "and industry != 'Other'\n",
        "and year(`date`) is not null\n",
        ";"
      ],
      "catalog": "world_layoffs",
      "schema": "layoffs"
    }
  ],
